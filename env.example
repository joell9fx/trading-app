# Copy to .env.local and fill in. Variables marked (unused) are not read by
# the current code and are kept only for planned features.

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Used by webhooks and admin routes after an admin check.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Site URLs ─────────────────────────────────────────────────────────
# Public base URL (redirects, referral links, profile URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side base URL for Stripe success/cancel redirects; falls back to NEXT_PUBLIC_SITE_URL
DOMAIN_URL=http://localhost:3000
# Used for metadataBase in app/layout.tsx
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Trading Academy
# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# ── Stripe ────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Price IDs per product (price_...). A product with no price shows "Coming Soon".
STRIPE_PRICE_SIGNALS=
STRIPE_PRICE_G2G=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_VIP=
STRIPE_PRICE_MENTORSHIP=
STRIPE_PRICE_COMMUNITY=
STRIPE_PRICE_FUNDING=
STRIPE_PRICE_COURSES=
STRIPE_PRICE_AUTO_TRADER=

# ── Internal server-to-server ─────────────────────────────────────────
# Shared secret for /api/services/webhook and internal reward/commission calls
SERVICE_WEBHOOK_SECRET=generate_a_long_random_string

# ── OpenAI (AI mentor, trade feedback, optimizer, admin insights) ─────
OPENAI_API_KEY=sk-your_openai_key

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Trading Academy <noreply@yourdomain.com>
# Support address shown on /support and /contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# ── (unused) planned integrations ─────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn
# REDIS_URL=redis://localhost:6379
# MUX_TOKEN_ID=your_mux_token_id
# MUX_TOKEN_SECRET=your_mux_token_secret
